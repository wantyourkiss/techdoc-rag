# Copy to .env; set both credentials before docker compose can start.
TECHDOC_BROWSER_USER=
TECHDOC_BROWSER_PASSWORD=
# Optional compatible chat-completions endpoint (base normally ends in /v1).
LLM_BASE_URL=
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_OUTPUT_MODE=json_schema
LLM_TIMEOUT_S=30
# Optional: only for a trusted proxy that overwrites both X-Techdoc headers.
TECHDOC_PROXY_AUTH_TOKEN=
# Required only with compose.dense.yaml; complete local model directories.
BGE_M3_HOST_DIR=
RERANKER_HOST_DIR=

# Optional official cloud parsing for new PDF/DOCX imports. Files leave this server.
TECHDOC_DOCUMENT_PARSER=local
TECHDOC_MINERU_API_TOKEN=
TECHDOC_MINERU_MODEL=vlm
TECHDOC_MINERU_TIMEOUT_S=600
